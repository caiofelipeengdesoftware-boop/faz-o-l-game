{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FAZ O L: multiplayer server",
      "type": "shell",
      "command": "npm run server",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> faz-o-l@",
          "endsPattern": "FAZ O L multiplayer listening on port 3001"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "FAZ O L: Vite game",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> faz-o-l@",
          "endsPattern": "Local:.*5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "FAZ O L: iniciar jogo",
      "dependsOn": [
        "FAZ O L: multiplayer server",
        "FAZ O L: Vite game"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
